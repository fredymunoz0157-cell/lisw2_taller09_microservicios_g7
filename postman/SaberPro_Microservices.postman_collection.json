            ],
            "url": {
              "raw": "http://localhost:8083/questions/1",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8083",
              "path": [
                "questions",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contexto\": \"Contexto corregido y ampliado: En la plataforma distribuida del Banco de Preguntas Saber PRO, cada microservicio tiene un contexto delimitado.\",\n  \"preguntaDirecta\": \"¿Cual microservicio actua como autoridad unica sobre el estado y las transiciones de una pregunta?\",\n  \"justificacionRespuesta\": \"Segun el diseno arquitectonico, Lifecycle Service es el unico que actualiza estados.\",\n  \"bibliografia\": \"Guia Taller 09 - Universidad del Cauca (2026).\",\n  \"competencia\": \"Ingenieria de Software\",\n  \"tema\": \"Arquitectura de Microservicios\",\n  \"subtema\": \"Patron State Authority\",\n  \"dificultad\": \"ALTO\",\n  \"authorId\": 1,\n  \"options\": [\n    {\n      \"id\": \"A\",\n      \"text\": \"Lifecycle Service (:8084), que procesa comandos y valida la maquina de estados.\",\n      \"correct\": true\n    },\n    {\n      \"id\": \"B\",\n      \"text\": \"User Service (:8081), que solo verifica credenciales de acceso.\",\n      \"correct\": false\n    },\n    {\n      \"id\": \"C\",\n      \"text\": \"Notification Service (:8086), que procesa eventos de correo diferido.\",\n      \"correct\": false\n    },\n    {\n      \"id\": \"D\",\n      \"text\": \"Validation Service (:8082), que verifica reglas estructurales sin persistir estados.\",\n      \"correct\": false\n    }\n  ],\n  \"correctOptionId\": \"A\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "5.4 Aprobar pregunta en IN_REVIEW con FormatoEvaluacion valido (-> Estado APPROVED)",
