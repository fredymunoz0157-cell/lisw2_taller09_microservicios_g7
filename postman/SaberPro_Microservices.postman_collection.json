          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.operationId) {",
                  "    pm.collectionVariables.set('operation_id', jsonData.operationId);",
                  "}"
                ]
              }
            }
          ]
        },
