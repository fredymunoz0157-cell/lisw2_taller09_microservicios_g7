    {
      "name": "2. Validation Service (:8082) - ValidadorEstructural",
      "item": [
        {
          "name": "2.1 Validar pregunta directamente (Exitoso)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
