              "raw": "{\n  \"contexto\": \"Corto\",\n  \"preguntaDirecta\": \"¿Pregunta?\",\n  \"options\": [\n    {\n      \"id\": \"A\",\n      \"text\": \"Todas las anteriores\",\n      \"correct\": false\n    },\n    {\n      \"id\": \"B\",\n      \"text\": \"Opcion 2\",\n      \"correct\": false\n    }\n  ],\n  \"correctOptionId\": \"\"\n}",
