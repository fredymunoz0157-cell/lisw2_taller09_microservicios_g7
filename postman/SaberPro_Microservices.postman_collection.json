                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8082/validate",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8082",
              "path": [
                "validate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contexto\": \"En el diseno de sistemas distribuidos basados en microservicios se emplean colas de mensajeria.\",\n  \"preguntaDirecta\": \"¿Cual es la ventaja principal de usar RabbitMQ para enviar el comando SubmitQuestionForReview?\",\n  \"options\": [\n    {\n      \"id\": \"A\",\n      \"text\": \"Desacoplar temporalmente el servicio emisor del consumidor y responder 202 Accepted.\",\n      \"correct\": true\n    },\n    {\n      \"id\": \"B\",\n      \"text\": \"Bloquear el hilo HTTP del cliente hasta que finalice toda la revision por pares.\",\n      \"correct\": false\n    },\n    {\n      \"id\": \"C\",\n      \"text\": \"Compartir la misma tabla de base de datos entre todos los microservicios.\",\n      \"correct\": false\n    },\n    {\n      \"id\": \"D\",\n      \"text\": \"Eliminar la necesidad de validar la estructura de la pregunta.\",\n      \"correct\": false\n    }\n  ],\n  \"correctOptionId\": \"A\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Question Service (:8083) - Creacion Sincrona y Envio Asincrono",
      "item": [
        {
          "name": "3.1 Crear pregunta valida -> Persistida en DRAFT (201 Created)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer saberpro-token-docente1-1",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8083/questions",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8083",
              "path": [
                "questions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contexto\": \"En una arquitectura de microservicios para el Banco de Preguntas Saber PRO, se requiere comunicacion sincrona y asincrona.\",\n  \"preguntaDirecta\": \"¿Que responsabilidad exclusiva tiene el microservicio Lifecycle Service dentro del dominio?\",\n  \"justificacionRespuesta\": \"Lifecycle Service es la unica autoridad encargada de validar y aplicar transiciones de estado de una pregunta.\",\n  \"bibliografia\": \"Guia Taller 09 - Laboratorio de Ingenieria de Software II, Universidad del Cauca.\",\n  \"competencia\": \"Ingenieria de Software\",\n  \"tema\": \"Arquitectura de Microservicios\",\n  \"subtema\": \"Gestion de Ciclo de Vida\",\n  \"dificultad\": \"MEDIO\",\n  \"authorId\": 1,\n  \"options\": [\n    {\n      \"id\": \"A\",\n      \"text\": \"Ser la autoridad unica sobre los estados y las transiciones de la pregunta.\",\n      \"correct\": true\n    },\n    {\n      \"id\": \"B\",\n      \"text\": \"Autenticar las credenciales del usuario mediante JWT.\",\n      \"correct\": false\n    },\n    {\n      \"id\": \"C\",\n      \"text\": \"Enviar correos electronicos directamente al estudiante.\",\n      \"correct\": false\n    },\n    {\n      \"id\": \"D\",\n      \"text\": \"Renderizar la interfaz grafica del cliente de escritorio.\",\n      \"correct\": false\n    }\n  ],\n  \"correctOptionId\": \"A\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "3.2 Crear pregunta invalida (Falla validacion -> 400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
